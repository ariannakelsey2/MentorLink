-- =========================================================
-- MentorLink Database Load Order Notes
-- =========================================================
-- This file is documentation ONLY.
-- It explains the correct order to run scripts due to
-- foreign key dependencies between tables.
-- DO NOT EXECUTE THIS FILE.
-- =========================================================


-- =========================
-- 1. DATABASE CREATION
-- =========================
-- Run first:
-- setup/create_database.sql


-- =========================
-- 2. TABLE CREATION ORDER
-- =========================
-- Tables must be created from parent → child

-- Independent tables (no dependencies)
-- These must be created FIRST
-- ---------------------------------
-- User
-- Subject
-- Mentorship

-- Dependent tables (require parent tables)
-- ---------------------------------

-- User_Subject
-- Depends on: User, Subject

-- MentorshipMember
-- Depends on: Mentorship, User

-- Session
-- Depends on: Mentorship

-- Goal
-- Depends on: Mentorship

-- Rating
-- Depends on: Mentorship, User


-- =========================
-- 3. SAMPLE DATA LOAD ORDER
-- =========================
-- Load data the SAME order as table creation

-- 1. User
-- 2. Subject
-- 3. Mentorship
-- 4. User_Subject
-- 5. MentorshipMember
-- 6. Session
-- 7. Goal
-- 8. Rating


-- =========================
-- 4. STORED PROCEDURES
-- =========================
-- Load AFTER all tables and data exist

-- procedures/*.sql


-- =========================
-- 5. TEST SCRIPTS
-- =========================
-- Run LAST

-- test-procedures/*.sql


-- =========================
-- SUMMARY EXECUTION ORDER
-- =========================
-- 1. create_database.sql
-- 2. schema (tables)
-- 3. sample data (CSV import or INSERTS)
-- 4. stored procedures
-- 5. test scripts


-- =========================================================
-- END OF FILE
-- =========================================================
